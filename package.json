{
  "name": "composable-locks",
  "version": "0.6.0",
  "description": "Composable concurrency locks for Javascript.",
  "keywords": [
    "async",
    "composable",
    "lock",
    "mutex",
    "reentrant"
  ],
  "homepage": "https://github.com/eblocha/composable-locks#readme",
  "license": "LGPL-3.0-or-later",
  "author": "eblocha",
  "repository": {
    "type": "git",
    "url": "https://github.com/eblocha/composable-locks"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "lint": "oxlint",
    "prepublishOnly": "pnpm test && pnpm lint && pnpm build",
    "size": "size-limit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    }
  }
}
